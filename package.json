{
  "name": "open-lens",
  "private": true,
  "scripts": {
    "dev": "concurrently -n app,server -c blue,green \"npm --prefix app run dev\" \"npm --prefix server run dev\"",
    "app": "npm --prefix app run dev",
    "server": "npm --prefix server run dev",
    "e2e:smoke": "node app/e2e/run.mjs",
    "e2e:us": "node app/e2e/run.mjs",
    "e2e:a2-a3": "node app/e2e/run.mjs US-A2 US-A3",
    "e2e:b1-b2-cv": "node app/e2e/run.mjs US-B1-B2-CV",
    "e2e:d1-d2-e1": "node app/e2e/run.mjs US-D1 US-D2 US-E1",
    "e2e:f2": "node app/e2e/offline-queue.mjs",
    "e2e:h3": "node app/e2e/capability-gate.mjs",
    "e2e:h1": "node app/e2e/pwa-install.mjs",
    "e2e:h2": "npm --prefix app run build && node app/e2e/opencv-cache.mjs",
    "e2e:c1": "node app/e2e/run.mjs US-C1",
    "e2e:d7": "node app/e2e/remote-detail.mjs",
    "e2e:a1": "node app/e2e/live-highlight.mjs"
  },
  "devDependencies": {
    "concurrently": "^9"
  }
}
