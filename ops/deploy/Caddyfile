openlens.renzhen.me {
	encode zstd gzip

	@backend path /api/* /files/* /mcp
	handle @backend {
		reverse_proxy 127.0.0.1:8787
	}

	handle {
		root * /opt/open-lens/current/app
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(self)"
	}
}
